<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto">

    <com.android.launcher3.settings.NotificationDotsPreference
        android:key="pref_icon_badging"
        android:title="@string/notification_dots_title"
        android:persistent="false"
        android:widgetLayout="@layout/notification_pref_warning" />

    <!-- MiraCLO: icon packs, one for the home screen and one for the app drawer -->
    <SwitchPreference
        android:key="pref_icon_pack_same"
        android:title="@string/miraclo_icon_pack_same_title"
        android:summary="@string/miraclo_icon_pack_same_summary"
        android:disableDependentsState="true"
        android:defaultValue="true"
        android:persistent="true" />

    <com.android.launcher3.settings.MiraCLOIconPackPreference
        android:key="pref_icon_pack_home"
        android:title="@string/miraclo_icon_pack_home_title"
        android:dialogTitle="@string/miraclo_icon_pack_home_title"
        android:persistent="true" />

    <com.android.launcher3.settings.MiraCLOIconPackPreference
        android:key="pref_icon_pack_drawer"
        android:title="@string/miraclo_icon_pack_drawer_title"
        android:dialogTitle="@string/miraclo_icon_pack_drawer_title"
        android:dependency="pref_icon_pack_same"
        android:persistent="true" />

    <!-- MiraCLO: ColorOS (stacked) or stock recents layout -->
    <com.android.launcher3.settings.MiraCLOListPreference
        android:key="pref_recents_style"
        android:title="@string/miraclo_recents_style_title"
        android:dialogTitle="@string/miraclo_recents_style_title"
        android:entries="@array/miraclo_recents_style_entries"
        android:entryValues="@array/miraclo_recents_style_values"
        android:defaultValue="coloros"
        android:persistent="true"
        launcher:useSimpleSummaryProvider="true" />

    <!--
      LAUNCHER_ADD_NEW_APPS_TO_HOME_SCREEN_ENABLED(613)
      LAUNCHER_ADD_NEW_APPS_TO_HOME_SCREEN_DISABLED(614)
    -->
    <SwitchPreference
        android:key="pref_add_icon_to_home"
        android:title="@string/auto_add_shortcuts_label"
        android:summary="@string/auto_add_shortcuts_description"
        android:defaultValue="true"
        android:persistent="true"
        launcher:logIdOn="613"
        launcher:logIdOff="614" />

</androidx.preference.PreferenceScreen>
